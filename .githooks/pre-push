#!/bin/sh
#
# Refuse to push unless the whole suite is green.
#
# This matters more than usual here: Heroku auto-deploys every push to main
# straight to production, with nothing in between. There is no CI gate and no
# review step, so this hook is the only thing standing between a broken commit
# and a live site.
#
# Enabled via `git config core.hooksPath .githooks` (see README). Bypass with
# `git push --no-verify` when you genuinely need to — pushing a WIP branch for
# a second opinion, say — but think twice on main.

set -eu

# A push can carry several refs at once. Git feeds them in on stdin as
#   <local ref> <local oid> <remote ref> <remote oid>
# and a deletion arrives with an all-zero local oid. A push that only deletes
# branches introduces no code, so there is nothing to test.
zero=$(git hash-object --stdin </dev/null | tr '[:alnum:]' '0')
has_content=0

while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  if [ "$local_oid" != "$zero" ]; then
    has_content=1
  fi
done

if [ "$has_content" -eq 0 ]; then
  echo "pre-push: deletion only, nothing to test."
  exit 0
fi

# GUI git clients often start with a minimal PATH that has no node/npm on it.
# Fail with an explanation rather than a bare "npm: not found".
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm not found on PATH." >&2
  echo "  Running from a GUI client? Push from a terminal, or bypass with --no-verify." >&2
  exit 1
fi

echo "pre-push: running the test suite..."

# Run from the repo root, not wherever the user happened to invoke git.
cd "$(git rev-parse --show-toplevel)"

if npm test >/tmp/car-calc-pre-push.log 2>&1; then
  # Echo the tally so a green run still shows what it proved.
  grep -E '^# (tests|pass|fail)' /tmp/car-calc-pre-push.log || true
  echo "pre-push: green, pushing."
  exit 0
fi

echo "" >&2
echo "pre-push: TESTS FAILED — push aborted." >&2
echo "" >&2
# Surface the failures themselves, not just the tally, so the reason is right
# here rather than behind another command.
grep -E '^not ok|^# (tests|pass|fail)' /tmp/car-calc-pre-push.log >&2 || true
echo "" >&2
echo "  Full output: /tmp/car-calc-pre-push.log" >&2
echo "  Re-run with: npm test" >&2
echo "  Override with: git push --no-verify" >&2
exit 1
